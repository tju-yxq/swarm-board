+    fn start_local_swarm(&mut self, task: &str) {
+        if self
+            .remote_connection
+            .as_ref()
+            .is_some_and(|connection| !connection.is_local_daemon)
+        {
+            self.add_error_message("/swarm requires a local Codex CLI session.".to_string());
+            return;
+        }
+        let Some(runner) = std::env::var_os("CODEX_SWARM_RUNNER").map(PathBuf::from) else {
+            self.add_error_message(
+                "Launch Codex with the Swarm Board launcher to configure /swarm.".to_string(),
+            );
+            return;
+        };
+        if !runner.is_absolute() || !runner.is_file() {
+            self.add_error_message(
+                "CODEX_SWARM_RUNNER must point to the Swarm Board runner.".to_string(),
+            );
+            return;
+        }
+        let cwd = self
+            .current_cwd
+            .clone()
+            .unwrap_or_else(|| self.config.cwd.to_path_buf());
+        let task = task.to_string();
+        let tx = self.app_event_tx.clone();
+        self.add_info_message("Starting local Swarm Board…".to_string(), None);
+        tokio::spawn(async move {
+            let mut command = tokio::process::Command::new("node");
+            command
+                .arg(runner)
+                .arg("--cwd")
+                .arg(&cwd)
+                .arg("--")
+                .arg(task)
+                .current_dir(cwd)
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null());
+            let result: std::io::Result<_> = async {
+                let mut child = command.spawn()?;
+                if let Some(stdout) = child.stdout.take() {
+                    let mut lines = tokio::io::BufReader::new(stdout).lines();
+                    while let Some(line) = lines.next_line().await? {
+                        let message = if let Some(url) = line.strip_prefix("SWARM_BOARD_URL=") {
+                            format!("Swarm Board: {url}")
+                        } else if let Some(status) = line.strip_prefix("SWARM_RUN_STATUS=") {
+                            format!("Swarm status: {status}")
+                        } else {
+                            continue;
+                        };
+                        tx.send(AppEvent::InsertHistoryCell(Box::new(
+                            history_cell::new_info_event(message, None),
+                        )));
+                    }
+                }
+                child.wait().await
+            }
+            .await;
+            let error = match result {
+                Ok(status) if status.success() => return,
+                Ok(status) => format!("Swarm runner failed ({status}). See the board for details."),
+                Err(error) => format!("Could not run Swarm Board: {error}"),
+            };
+            tx.send(AppEvent::InsertHistoryCell(Box::new(
+                history_cell::new_error_event(error),
+            )));
+        });
+    }
